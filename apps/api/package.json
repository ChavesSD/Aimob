{
  "name": "@aimob/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx --env-file=.env src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:pg": "cross-env TEST_PG=1 vitest run",
    "backup": "tsx --env-file=.env src/db/backup-cli.ts backup",
    "restore": "tsx --env-file=.env src/db/backup-cli.ts restore"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
