# Copie para .env (arquivo ignorado pelo git). Nunca commite segredos. Veja docs/OPERACAO.md.

# --- Desenvolvimento ---
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
SEED_PASSWORD=troque-por-uma-senha-de-pelo-menos-12-caracteres
PORT=3100
DATA_DIR=./data/pg
CORS_ORIGIN=http://localhost:5274

# --- Produção (NODE_ENV=production exige tudo isto) ---
# NODE_ENV=production
# DATABASE_URL=postgres://usuario:senha@host:5432/aimob
# DATA_ENC_KEY=um-segredo-aleatorio-com-pelo-menos-32-caracteres   # protege CPF/CNPJ e chaves de gateway
# PUBLIC_API_URL=https://api.seudominio.com.br                    # endereço público (https) usado no webhook de pagamentos
# MFA_ENC_KEY=outro-segredo-aleatorio-com-pelo-menos-32-caracteres
# BACKUP_ENC_KEY=mais-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# IP_HASH_SALT=sal-aleatorio-com-pelo-menos-16-caracteres
# TRUST_PROXY=true
# HOST=0.0.0.0

# Leitura dos diagnósticos da landing (mín. 24 caracteres). Sem isto a rota fica desligada.
PLATFORM_ADMIN_TOKEN=

# --- Asaas da plataforma (mesmos nomes de variáveis do Aidate). Veja docs/PAGAMENTOS.md ---
# ASAAS_API_KEY=                       # chave da conta principal (nunca no repositório)
# ASAAS_API_URL=https://api.asaas.com/v3   # padrão: produção. Sandbox: https://api-sandbox.asaas.com/v3
# ASAAS_USER_AGENT=Aimob
# ASAAS_WEBHOOK_TOKEN=                 # 32 a 255 caracteres; o mesmo cadastrado no webhook do Asaas para o Aimob

# --- Somente desenvolvimento: Asaas simulado (npm run mock:asaas) ---
# ASAAS_API_KEY=$aact_dev_chave_simulada_0000000000
# ASAAS_API_URL=http://127.0.0.1:4010/v3
# PUBLIC_API_URL=http://127.0.0.1:3100
